{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/admin/**",
              "components/commerce/**",
              "components/core/**",
              "components/forms/**",
              "components/shell/**",
              "ui_kits/admin/**",
              "ui_kits/storefront/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Hind Siliguri|Manrope|Marcellus|Amiri))/i]",
        "message": "Font not provided by the design system. Available: Hind Siliguri, Manrope, Marcellus, Amiri."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|storeLink|key|ref|className|style|children)$/]",
        "message": "<AdminNav> doesn't accept that prop. Declared props: items, value, onChange, storeLink."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:discount|tag|fresh|save|offer|count)$/]",
        "message": "<Badge> tone must be one of 'discount' | 'tag' | 'fresh' | 'save' | 'offer' | 'count'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|iconLeft|block|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, icon, iconLeft, block."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ink|ghost|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ink' | 'ghost' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CartLineItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:item|variant|onRemove|key|ref|className|style|children)$/]",
        "message": "<CartLineItem> doesn't accept that prop. Declared props: item, variant, onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|image|alt|key|ref|className|style|children)$/]",
        "message": "<CategoryCard> doesn't accept that prop. Declared props: label, count, image, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|note|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|as|options|rows|tone|placeholder|value|required|type|onChange|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, as, options, rows, tone, placeholder, value, required, type, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea|select)$/]",
        "message": "<Field> as must be one of 'input' | 'textarea' | 'select'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|raised)$/]",
        "message": "<Field> tone must be one of 'light' | 'raised'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FreeShippingMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|threshold|key|ref|className|style|children)$/]",
        "message": "<FreeShippingMeter> doesn't accept that prop. Declared props: total, threshold."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|size|iconSize|badge|active|label|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, tone, size, iconSize, badge, active, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:maroon|white|outline|table|bare)$/]",
        "message": "<IconButton> tone must be one of 'maroon' | 'white' | 'outline' | 'table' | 'bare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InventoryRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:product|onEdit|onDelete|key|ref|className|style|children)$/]",
        "message": "<InventoryRow> doesn't accept that prop. Declared props: product, onEdit, onDelete."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|key|ref|className|style|children)$/]",
        "message": "<Kicker> doesn't accept that prop. Declared props: icon, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:maroon|gold|green)$/]",
        "message": "<Kicker> tone must be one of 'maroon' | 'gold' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:tagline|size|tone|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: tagline, size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:maroon|light)$/]",
        "message": "<Logo> tone must be one of 'maroon' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|note|key|ref|className|style|children)$/]",
        "message": "<MetricCard> doesn't accept that prop. Declared props: label, value, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='OfferBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|highlight|timerLabel|timer|action|key|ref|className|style|children)$/]",
        "message": "<OfferBanner> doesn't accept that prop. Declared props: eyebrow, title, highlight, timerLabel, timer, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrderRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:order|onStatusChange|key|ref|className|style|children)$/]",
        "message": "<OrderRow> doesn't accept that prop. Declared props: order, onStatusChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrderSummary'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|subtotal|deliveryFee|benefits|key|ref|className|style|children)$/]",
        "message": "<OrderSummary> doesn't accept that prop. Declared props: items, subtotal, deliveryFee, benefits."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaymentOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|note|key|ref|className|style|children)$/]",
        "message": "<PaymentOption> doesn't accept that prop. Declared props: label, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardProduct'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|slug|bn|name|price|oldPrice|category|image|image2|tag|key|ref|className|style|children)$/]",
        "message": "<CardProduct> doesn't accept that prop. Declared props: id, slug, bn, name, price, oldPrice, category, image, image2, tag."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductGallery'] > JSXAttribute > JSXIdentifier[name!=/^(?:productName|frontImage|detailImage|height|key|ref|className|style|children)$/]",
        "message": "<ProductGallery> doesn't accept that prop. Declared props: productName, frontImage, detailImage, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuantityStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|width|height|key|ref|className|style|children)$/]",
        "message": "<QuantityStepper> doesn't accept that prop. Declared props: value, onChange, width, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rating'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|reviews|stars|inStock|key|ref|className|style|children)$/]",
        "message": "<Rating> doesn't accept that prop. Declared props: value, reviews, stars, inStock."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|action|size|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: kicker, title, action, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:line|legal|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: line, legal."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:nav|search|onSearch|cartCount|wishlistCount|onCart|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: nav, search, onSearch, cartCount, wishlistCount, onCart."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|underline|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, value, onChange, underline."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|note|icon|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: message, note, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|title|note|divider|key|ref|className|style|children)$/]",
        "message": "<TrustItem> doesn't accept that prop. Declared props: glyph, title, note, divider."
      },
      {
        "selector": "JSXOpeningElement[name.name='VariantPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|meta|options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<VariantPicker> doesn't accept that prop. Declared props: label, meta, options, value, onChange."
      }
    ]
  },
